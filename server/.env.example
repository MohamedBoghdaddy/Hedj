# ─── MongoDB ────────────────────────────────────────────────────────────────────
# Primary Atlas connection string (MONGO_URI is read first).
# mongodb+srv requires DNS SRV/TXT resolution for _mongodb._tcp.<cluster-host>.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Backward-compatible fallback. Used only when MONGO_URI is empty.
# If SRV DNS fails on your network, use the Atlas standard non-SRV string here.
MONGO_URL=

# ─── App / Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-session-secret
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────────────
# Project URL from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon / public key – safe to expose in browser builds if needed (not used here)
SUPABASE_ANON_KEY=

# Service role secret – BACKEND ONLY. Never expose in React / frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase Storage Bucket Names ──────────────────────────────────────────────
# Create these buckets in Supabase Dashboard → Storage → Buckets
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images
SUPABASE_EMPLOYEE_IMAGES_BUCKET=employee-images
SUPABASE_EMAIL_ATTACHMENTS_BUCKET=email-attachments

# ─── Email (sender identity) ────────────────────────────────────────────────────
EMAIL_FROM_NAME=Hedj Commerce
EMAIL_FROM_ADDRESS=noreply@hedjcommerce.com

# ─── Email Delivery Provider (choose one or leave blank to queue-only) ───────────
# Option A – SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Option B – Resend  https://resend.com
RESEND_API_KEY=

# Option C – SendGrid  https://sendgrid.com
SENDGRID_API_KEY=
