# Primary MongoDB Atlas connection string. MONGO_URI is read first.
# mongodb+srv requires DNS SRV/TXT resolution for _mongodb._tcp.<cluster-host>.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Backward-compatible fallback. Used only when MONGO_URI is empty.
# If SRV DNS fails on your network, use the Atlas standard non-SRV mongodb:// string here or in MONGO_URI.
MONGO_URL=

JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-session-secret
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
